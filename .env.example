# Vorlage: nach .env kopieren (cp .env.example .env) und Platzhalter ersetzen. .env gehört nie in Git.

# --- Datenbank (Pflicht) ---
POSTGRES_DB=ultimatetodo
POSTGRES_USER=ultimatetodo
# Zufälliges, eigenes Passwort setzen, zum Beispiel: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_EIGENES_ZUFAELLIGES_PASSWORT_EINTRAGEN

# --- Ports (optional, nur localhost) ---
WEB_PORT=8080
BACKEND_PORT=8081
DEV_DB_PORT=5432

# --- Sitzung (optional) ---
# Hinter HTTPS zwingend true. Nur der lokale HTTP-Lernbetrieb auf localhost darf false verwenden.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=30m

# --- Erstmalige Admin-Einrichtung (optional, US-014) ---
# Registriere zuerst ein normales Konto mit dieser E-Mail-Adresse, trage sie dann hier ein und starte den
# Stack neu (docker compose up -d --build --wait): das Konto wird beim Start zum Administrator befördert.
# Danach wieder leer lassen oder entfernen; kein Standardkennwort, kein öffentlicher Bootstrap-Endpunkt.
ADMIN_BOOTSTRAP_EMAIL=
