# Vorlage: nach .env kopieren (cp .env.example .env) und Platzhalter ersetzen. .env gehört nie in Git.

# --- Datenbank (Pflicht) ---
POSTGRES_DB=ultimatetodo
POSTGRES_USER=ultimatetodo
# Zufälliges, eigenes Passwort setzen, zum Beispiel: openssl rand -base64 24
POSTGRES_PASSWORD=HIER_EIGENES_ZUFAELLIGES_PASSWORT_EINTRAGEN

# --- Ports (optional, nur localhost) ---
WEB_PORT=8080
BACKEND_PORT=8081
DEV_DB_PORT=5432
